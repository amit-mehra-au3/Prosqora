PORT=5001
# Optional Web Search API Keys (If unconfigured, compliant DuckDuckGo live parser is used automatically)
SEARCH_PROVIDER=duckduckgo # Options: duckduckgo, google, serpapi
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
SERPAPI_KEY=

# Optional AI API Key for Opportunity Synthesis (If unconfigured, rule-based extraction from website text is used)
OPENAI_API_KEY=
GEMINI_API_KEY=

# App Settings
DEMO_MODE=false
