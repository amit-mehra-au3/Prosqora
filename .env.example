# PROSQORA PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (RENDER)
# Copy to .env for local testing or populate inside Render Web Service Dashboard

# Server Settings
PORT=5001
NODE_ENV=production
APP_URL=https://prosqora.onrender.com
CORS_ORIGIN=https://prosqora.onrender.com

# Authentication Security (Generate a 64+ char random secret)
JWT_SECRET=your_secure_jwt_secret_key_here_min_64_characters

# Database Connection (Uses local SQLite by default or PostgreSQL if DATABASE_URL is provided)
DATABASE_URL=file:./prosqora.db

# Payment Integration (Razorpay India - INR ₹)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Official Business Gmail Connection (OAuth2)
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=https://prosqora.onrender.com/api/gmail/callback
BUSINESS_EMAIL=amautomationtrading@gmail.com

# Optional Intelligence & Search Enhancements
SEARCH_PROVIDER=duckduckgo
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
SERPAPI_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
